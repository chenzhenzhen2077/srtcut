PODCAST_CUTTER_HOST=127.0.0.1
PODCAST_CUTTER_PORT=8964
PODCAST_CUTTER_MAX_UPLOAD_MB=2048
PODCAST_CUTTER_MAX_CUTS=2000
PODCAST_CUTTER_WHISPER_MODEL=small
PODCAST_CUTTER_WHISPER_DEVICE=cpu
PODCAST_CUTTER_WHISPER_COMPUTE_TYPE=int8
PODCAST_CUTTER_WHISPER_MAX_DURATION_MINUTES=180
# Server-side semantic proposals. Never expose this key to browser code.
PODCAST_CUTTER_AI_API_KEY=
PODCAST_CUTTER_AI_BASE_URL=https://api.openai.com/v1
PODCAST_CUTTER_AI_MODEL=gpt-4.1-mini
# Optional custom paths:
# PODCAST_CUTTER_WORK_DIR=/absolute/path/to/work
# PODCAST_CUTTER_BIN_DIR=/absolute/path/to/bin
